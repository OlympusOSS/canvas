		"@tiptap/starter-kit": "^2.10.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"codemirror": "^6.0.1",
		"d3-geo": "^3.1.1",
