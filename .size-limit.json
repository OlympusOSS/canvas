[
	{
		"name": "Full barrel (tree-shakeable, everything)",
		"path": "src/index.ts",
		"limit": "410 KB",
		"gzip": true,
		"ignore": [
			"react",
			"react-dom",
			"@rjsf/core",
			"@rjsf/utils",
			"@rjsf/validator-ajv8",
			"libphonenumber-js",
			"recharts",
			"react-grid-layout",
			"next-themes",
			"@codemirror/commands",
			"@codemirror/lang-css",
			"@codemirror/lang-html",
			"@codemirror/lang-javascript",
			"@codemirror/lang-json",
			"@codemirror/lang-markdown",
			"@codemirror/language",
			"@codemirror/state",
			"@codemirror/view",
			"@tiptap/core",
			"@tiptap/extension-link",
			"@tiptap/extension-placeholder",
			"@tiptap/react",
			"@tiptap/starter-kit"
		]
	},
	{
		"name": "Core atoms (no Icon)",
		"path": "src/index.ts",
		"import": "{ Button, Input, Label, Badge, Checkbox, Switch }",
		"limit": "40 KB",
		"gzip": true,
		"ignore": ["react", "react-dom"]
	},
	{
		"name": "Icon (pulls all of lucide-react)",
		"path": "src/index.ts",
		"import": "{ Icon }",
		"limit": "200 KB",
		"gzip": true,
		"ignore": ["react", "react-dom"]
	},
	{
		"name": "Page chrome (PageHeader + ActionBar + SectionCard + PageTabs)",
		"path": "src/index.ts",
		"import": "{ PageHeader, ActionBar, SectionCard, PageTabs }",
		"limit": "200 KB",
		"gzip": true,
		"ignore": ["react", "react-dom"]
	},
	{
		"name": "DataTable (TanStack Table)",
		"path": "src/index.ts",
		"import": "{ DataTable }",
		"limit": "60 KB",
		"gzip": true,
		"ignore": ["react", "react-dom"]
	},
	{
		"name": "SchemaForm (without RJSF peer dep)",
		"path": "src/index.ts",
		"import": "{ SchemaForm }",
		"limit": "200 KB",
		"gzip": true,
		"ignore": ["react", "react-dom", "@rjsf/core", "@rjsf/utils", "@rjsf/validator-ajv8"]
	}
]
